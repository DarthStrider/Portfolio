# Copy to .env to override the defaults in docker-compose.yml. Every value is optional.

# The first admin account, created on first start.
ADMIN_EMAIL=admin@northline.test
ADMIN_PASSWORD=northline-admin

# Shared secret for service-to-service calls (payment -> order). Change it outside local dev.
INTERNAL_TOKEN=dev-internal-token-change-me

# Laravel's encryption key. Generate your own with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Stripe test mode (optional). Leave empty to use the built-in test payment provider.
# Keys: https://dashboard.stripe.com/test/apikeys
# Webhook secret: run `stripe listen --forward-to localhost:8090/api/v1/payments/webhook`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
