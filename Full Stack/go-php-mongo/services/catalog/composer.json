{
    "name": "northline/catalog-service",
    "description": "Catalog, reviews and content for the Northline shop (Laravel + MongoDB).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mongodb": "*",
        "laravel/framework": "^12.0",
        "mongodb/mongodb": "^1.20 || ^2.0",
        "firebase/php-jwt": "^7.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0",
            "ext-mongodb": "2.5.0",
            "ext-sockets": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
