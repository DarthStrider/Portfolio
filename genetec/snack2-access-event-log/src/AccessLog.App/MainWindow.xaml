<Window x:Class="AccessLog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Access Event Log" Width="1000" Height="640" MinWidth="720" MinHeight="420"
        DataContext="{Binding Main, Source={StaticResource Locator}}"
        Background="#F6F7F9" FontSize="13">

    <DockPanel>
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StoreDescription}" />
            <Separator />
            <StatusBarItem Content="{Binding Status}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="Updated " />
                    <Run Text="{Binding LastRefreshedUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=HH:mm:ss}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="12">
            <!-- Events -->
            <TabItem Header="Events">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="260" Padding="6,4"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ToolTip="Door, camera, location or cardholder" />
                        <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding OutcomeOptions}"
                                  SelectedItem="{Binding Outcome}" />
                        <Button Content="Clear" Padding="12,4" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
                        <Button Content="Refresh" Padding="12,4" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Width="150"
                                                Binding="{Binding OccurredAtUtc, Converter={StaticResource UtcToLocal}}" />
                            <DataGridTextColumn Header="Device" Width="170" Binding="{Binding DeviceName}" />
                            <DataGridTextColumn Header="Location" Width="120" Binding="{Binding Location}" />
                            <DataGridTextColumn Header="Cardholder" Width="170" Binding="{Binding CardholderName}" />
                            <DataGridTemplateColumn Header="Outcome" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource OutcomeBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Reports -->
            <TabItem Header="Reports">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Denied access by door, last 24 h"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding DeniedByDoor}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Door" Width="*" Binding="{Binding DeviceName}" />
                                <DataGridTextColumn Header="Location" Width="*" Binding="{Binding Location}" />
                                <DataGridTextColumn Header="Denied" Width="80" Binding="{Binding Denied}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Top 5 noisiest devices, last 24 h"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding NoisiestDevices}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device" Width="*" Binding="{Binding DeviceName}" />
                                <DataGridTextColumn Header="Kind" Width="90" Binding="{Binding Kind}" />
                                <DataGridTextColumn Header="Events" Width="80" Binding="{Binding Events}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
