<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF app on .NET Framework 4.8, as the README asks. Everything it shows comes from AccessLog.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AccessLog</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessLog.Core\AccessLog.Core.csproj" />
  </ItemGroup>

</Project>
