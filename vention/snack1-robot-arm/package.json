{
  "name": "robot-arm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run db:up && vite",
    "start:mongo": "npm run db:up:mongo && vite",
    "db:up": "docker compose -f ../snack5-inventory/docker-compose.yml --profile postgres up -d --build --wait",
    "db:up:mongo": "docker compose -f ../snack5-inventory/docker-compose.yml --profile mongo up -d --build --wait",
    "db:down": "docker compose -f ../snack5-inventory/docker-compose.yml --profile postgres --profile mongo down",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "build:gripper": "tsx scripts/build-gripper.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
